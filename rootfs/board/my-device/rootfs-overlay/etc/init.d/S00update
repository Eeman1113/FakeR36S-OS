#!/bin/sh
# FakeR36S-OS: install an update package left in HOME/update/ (see /usr/local/bin/fr-update).
# Runs right after the logo appears and before anything else uses the system files.
[ "$1" = start ] || exit 0
ls /home/player/update/fakers36s-update*.tar >/dev/null 2>&1 || exit 0
/usr/local/bin/fr-update
exit 0
