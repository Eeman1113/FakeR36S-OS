#!/bin/sh
# FakeR36S-OS animated boot splash (about 4 s, any button skips). Runs before appd
# starts EmulationStation. Never blocks boot: hard-capped at 8 s.
[ "$1" = start ] || exit 0
killall fr-loading 2>/dev/null
[ -e /home/player/.config/fakers36s/no-splash ] && exit 0
export HOME=/root SDL_VIDEODRIVER=kmsdrm
. /etc/profile.d/sdl_controller.sh 2>/dev/null
/usr/bin/bootsplash </dev/null >/dev/null 2>&1 &
pid=$!
( sleep 8; kill -9 $pid 2>/dev/null ) &
wait $pid 2>/dev/null
# hold the logo with a spinner until EmulationStation draws
[ -x /usr/bin/fr-loading ] && /usr/bin/fr-loading 30 </dev/null >/dev/null 2>&1 &
exit 0
