#!/bin/sh
# Reader (Options): KOReader with the books in HOME/read, opened on the cover dashboard.
# Select+Start closes it (fr-padwatch). Settings, fonts and reading positions live in HOME,
# so they survive OS updates. Night mode (dark) is in KOReader's top menu.
H=/home/player
CONF=$H/.config/koreader
mkdir -p "$H/read" "$CONF" "$H/.local/share/fonts" "$H/.config/fakers36s"
[ -f "$CONF/settings.reader.lua" ] || cp /usr/share/fakers36s/koreader/settings.reader.lua "$CONF/"

export HOME=$H XDG_CONFIG_HOME=$H/.config XDG_DATA_HOME=$H/.local/share
export SDL_VIDEODRIVER=kmsdrm
. /etc/profile.d/sdl_controller.sh 2>/dev/null
doas /usr/local/bin/cpuprofile light 2>/dev/null   # reading needs little CPU: the battery lasts longer
/usr/bin/fr-padwatch /opt/koreader/koreader.sh "$H/read" >> "$H/.config/fakers36s/reader.log" 2>&1
rc=$?
doas /usr/local/bin/cpuprofile normal 2>/dev/null
exit $rc
