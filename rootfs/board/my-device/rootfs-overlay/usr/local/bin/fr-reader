#!/bin/sh
# Reader (Options): KOReader with the books in HOME/read, opened on the cover dashboard.
# Select+Start closes it (fr-padwatch). Settings, fonts and reading positions live in HOME,
# so they survive OS updates. Night mode (dark) is in KOReader's top menu.
H=/home/player
CONF=$H/.config/koreader
mkdir -p "$H/read" "$CONF" "$H/.local/share/fonts" "$H/.config/fakers36s"
[ -f "$CONF/settings.reader.lua" ] || cp /usr/share/fakers36s/koreader/settings.reader.lua "$CONF/"
# our defaults (page turns on the D-pad, offline-useless plugins off), merged without touching
# anything changed inside KOReader
/opt/koreader/luajit /usr/share/fakers36s/koreader/fr-settings.lua "$CONF/settings.reader.lua" 2>/dev/null

export HOME=$H XDG_CONFIG_HOME=$H/.config XDG_DATA_HOME=$H/.local/share
export SDL_VIDEODRIVER=kmsdrm
# button mode: KOReader's desktop build assumes a touchscreen, where lists have no selection to
# move with the D-pad. Touchless mode is the one it uses on e-readers with keys.
export DISABLE_TOUCH=1
. /etc/profile.d/sdl_controller.sh 2>/dev/null
LOG=$H/.config/fakers36s/reader.log
# KOReader runs at the normal CPU profile: the light one cost ~20% on every page layout and made
# the first start crawl. (The governor still idles the cores between page turns.) A spinner covers
# the start until the library is up (KOReader opens the gamepad last).
killall fr-loading 2>/dev/null
[ -x /usr/bin/fr-loading ] && setsid /usr/bin/fr-loading 240 </dev/null >/dev/null 2>&1 &
doas /usr/local/bin/cpuprofile normal 2>/dev/null
[ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 500000 ] && : > "$LOG"   # keep the log small
echo "=== reader start $(date)" >> "$LOG"
start=$(wc -c < "$LOG")
(
    i=0
    while [ $i -lt 240 ]; do
        tail -c +$((start + 1)) "$LOG" | grep -q 'opened gamecontroller' && break
        # startup trace every 2 s: is KOReader computing (state R, cpu ticks rising) or waiting?
        if [ $((i % 2)) = 0 ] && P=$(pidof luajit) && [ -n "$P" ]; then
            P=${P%% *}
            echo "T+${i}s $(awk '{print "state=" $3 " cpu=" $14+$15}' /proc/$P/stat 2>/dev/null)" \
                "mhz=$(( $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null || echo 0) / 1000 ))" \
                "$(awk '/MemAvailable|SwapFree/ {printf "%s%dM ", $1, $2 / 1024}' /proc/meminfo)" >> "$LOG"
        fi
        sleep 1; i=$((i + 1))
    done
    killall fr-loading 2>/dev/null
    echo "=== library up after ${i}s" >> "$LOG"
) &
WATCH=$!
/usr/bin/fr-padwatch /opt/koreader/koreader.sh "$H/read" >> "$LOG" 2>&1
rc=$?
kill $WATCH 2>/dev/null
killall fr-loading 2>/dev/null
doas /usr/local/bin/cpuprofile normal 2>/dev/null
exit $rc
