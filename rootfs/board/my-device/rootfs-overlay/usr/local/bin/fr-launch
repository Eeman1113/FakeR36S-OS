#!/bin/sh
# fr-launch <light|normal> <core> <rom>: run a game with the right CPU profile, restore afterwards.
# Battery saver can be switched off from the System Dashboard. Autosave (SRAM every 60 s, a state on
# exit, resume on launch) and the low-battery messages come from retroarch-always.cfg, appended every time.
profile=$1; core=$2; shift 2
[ -e /home/player/.config/fakers36s/battery-saver-off ] && profile=normal
doas /usr/local/bin/cpuprofile "$profile" 2>/dev/null
retroarch --appendconfig /usr/share/fakers36s/retroarch-always.cfg -L "/usr/lib/libretro/${core}_libretro.so" "$@"
rc=$?
doas /usr/local/bin/cpuprofile normal 2>/dev/null
exit $rc
